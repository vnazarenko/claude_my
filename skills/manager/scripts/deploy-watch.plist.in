<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.@USER@.manager-deploy-watch</string>
  <key>ProgramArguments</key><array><string>/opt/homebrew/bin/bash</string><string>@HOME@/.claude/skills/manager/scripts/deploy-watch.sh</string></array>
  <key>WatchPaths</key><array>
@PATHS@
  </array>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>@HOME@/Library/Logs/manager-tick.log</string>
  <key>StandardErrorPath</key><string>@HOME@/Library/Logs/manager-tick.launchd.log</string>
</dict>
</plist>
